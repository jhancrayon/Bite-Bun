          <mxGeometry x="320" y="810" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e1" value="Chưa → Đăng ký" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;fontStyle=1;exitX=0;exitY=0.5;" edge="1" parent="1" source="d1" target="r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="225" /></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="Có → Đăng nhập" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;fontStyle=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="d1" target="l1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="225" /></Array></mxGeometry></mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;entryX=0.25;entryY=0;" edge="1" parent="1" source="r2" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="480" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;entryX=0.75;entryY=0;" edge="1" parent="1" source="l2" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="480" /></Array></mxGeometry></mxCell>

        <mxCell id="e7" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d9161c;fontColor=#d9161c;fontStyle=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="d2" target="err"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Sửa lại → nhập tiếp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d9161c;fontColor=#d9161c;fontStyle=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="err" target="l1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="345" /></Array></mxGeometry></mxCell>

        <mxCell id="e9" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;fontStyle=1;" edge="1" parent="1" source="d2" target="ok1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;" edge="1" parent="1" source="ok1" target="ok2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7a5b52;" edge="1" parent="1" source="ok2" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>

