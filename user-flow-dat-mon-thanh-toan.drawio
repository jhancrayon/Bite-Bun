        <mxCell id="p1" value="Chọn hình thức ở thanh đặt món:&#10;Giao hàng / Tự đến lấy&#10;(đồng bộ với nav)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fa6932;fontColor=#ffffff;strokeColor=none;fontSize=13;" vertex="1" parent="1">
