        <mxCell id="start" value="Menu Tài khoản → &quot;Điểm thưởng&quot;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7f292a;fontColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1">
